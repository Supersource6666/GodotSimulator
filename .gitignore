# Godot 4 editor/import cache. Keep source-side *.import and *.uid files tracked.
/.godot/
/.mono/
*.translation

# Local export credentials and generated application packages.
/export/
/exports/
/dist/
export_credentials.cfg
*.pck
*.apk
*.aab
*.ipa

# Native/CMake build trees and generated metadata.
/build/
/build-*/
/cmake-build-*/
/out/
/CMakeFiles/
/Testing/
/CMakeCache.txt
/CTestTestfile.cmake
/cmake_install.cmake
/compile_commands.json
*.o
*.pdb
*.ilk
*.dSYM/

# Local credentials and environment overrides.
/cesium_token.txt
/google_maps_api_key.txt
/.env
/.env.*
!/.env.example
*.pem

# Runtime state, logs, dumps and generated output.
/appdata/
/logs/
/output/
/outputs/
/temp/
/tmp/
*.log
*.dmp
*.stackdump
mono_crash.*

# Generated captures and diagnostic images.
/offline-preview.png
/offline-preview.png.import
/cab-preview.png
/cab-preview.png.import
/wheel-preview.png
/wheel-preview.png.import
/train-diagnostic.png
/train-diagnostic.png.import
/screenshots/
/captures/

# Scene previews regenerated by capture commands.
/scenes/travel/preview.png
/scenes/travel/track_detail.png

# Large offline map/model sources are distributed separately.
# Keep manifests, scripts and offline_data/dynamic_data tracked.
/offline_data/models/
/offline_data/sources/

# Test reports and language/tool caches. Test source directories are tracked.
/test-results/
/coverage/
/.coverage
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/
**/__pycache__/
*.py[cod]
/node_modules/
*.tsbuildinfo

# IDE/editor-local state.
/.idea/
/.vscode/
/.vs/
/.fleet/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo

# Operating-system metadata.
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Temporary, backup and root-level diagnostic helpers.
*.tmp
*.temp
*.bak
*.old
*~
/_tmp*
/_debug*
/_diagnostic*
/_test*
